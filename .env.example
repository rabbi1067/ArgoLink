# =====================================================================
# AgroLink - environment variables (development + deployment)
# Copy to `.env` locally (do NOT commit) or set in your hosting provider.
# Every variable in this file is read by src/main/resources/application*.yml
# No real secrets are committed anywhere in this repo on purpose.
# =====================================================================

# --- MongoDB Atlas ----------------------------------------------------
# Full connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/agrolink?retryWrites=true&w=majority
MONGODB_URI=

# Server port (Render injects PORT; SERVER_PORT is the fallback)
PORT=8080
SERVER_PORT=8080

# --- JWT ----------------------------------------------------------------
# Long random string (64+ chars). Generate with: openssl rand -base64 48
# The app REFUSES to start without it - there is no default secret.
JWT_SECRET=
# 24h in ms
JWT_EXPIRATION_MS=86400000

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8081

# --- Cloudinary (image uploads) ------------------------------------------
# Empty = uploads fall back to MongoDB storage. Set all three for CDN.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- EmailJS (forgot-password emails) --------------------------------------
# Empty = reset codes are only logged server-side (dev mode).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Gemini (AI Assist) ------------------------------------------------------
# Empty = assistant answers "not configured". Free key: aistudio.google.com
GEMINI_API_KEY=

# --- Demo mode --------------------------------------------------------------
# true = public demo logins (Super Admin / Admin / Buyer / Farmer)
AGROLINK_DEMO_ENABLED=true

# --- Abuse protection (tuned defaults, override only if needed) --------------
# AGROLINK_RATE_LIMIT_AUTH=10
# AGROLINK_RATE_LIMIT_PUBLIC=60
# AGROLINK_RATE_LIMIT_API=120
# AGROLINK_RATE_LIMIT_GLOBAL=600
# AGROLINK_MAX_JSON_BYTES=262144
# AGROLINK_AUTO_SUSPEND_ENABLED=true
# AGROLINK_AUTO_SUSPEND_STRIKES=5
# AGROLINK_AUTO_SUSPEND_WRITES_PER_HOUR=60

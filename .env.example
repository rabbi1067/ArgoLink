# =====================================================================
# AgroLink — environment variables (development + deployment)
# Copy to `.env` locally (do NOT commit) or set in your hosting provider.
# Every variable in this file is read by src/main/resources/application*.yml
# =====================================================================

# --- MongoDB Atlas ----------------------------------------------------
# Full connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/agrolink?retryWrites=true&w=majority
MONGODB_URI=

# Server port (Render/Fly.io/Heroku inject PORT; SERVER_PORT is the fallback)
PORT=8080
SERVER_PORT=8080

# --- JWT ----------------------------------------------------------------
# Use a long random string (>32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=
# 24h in ms
JWT_EXPIRATION_MS=86400000

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8081
</content>
